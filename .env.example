# Copy this file to ".env" and fill in your real values.
# Never commit the real .env file to GitHub.

# Your PostgreSQL connection string from Step 1, Part D.
# Replace YOUR_PASSWORD with the password you set during PostgreSQL install.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/agrisphere

# Any long random string - this signs your login tokens.
# Just mash the keyboard for 30+ characters, it doesn't need to mean anything.
JWT_SECRET=replace_this_with_a_long_random_string_of_your_own

# Port the backend server runs on.
PORT=5000